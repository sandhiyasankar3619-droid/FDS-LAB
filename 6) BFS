#include <stdio.h> 
#define MAX 50 
int main()
{ 
int graph[MAX][MAX];
int visited[MAX];
int queue[MAX};
int n, i, j;
int front = 0, rear = 0;  
int start, current;   
printf("Enter number of vertices: ");   
scanf("%d", &n);    
printf("Enter the adjacency matrix:\n"); 
for (i = 0; i < n; i++)
{        
for (j = 0; j < n; j++) 
{             
scanf("%d", &graph[i][j]);  
}   
}    
for (i = 0; i < n; i++)  
{        
visited[i] = 0;  
}      
printf("Enter starting vertex: "); 
scanf("%d", &start);     
visited[start] = 1;
queue[rear] = start;
rear++; 
printf("BFS Traversal: "); 
while (front < rear) 
{         
current = queue[front];  
front++;
printf("%d ", current); 
for (i = 0; i < n; i++) 
{ 
if (graph[current][i] == 1 && visited[i] == 0) 
{                
visited[i] = 1;  
queue[rear] = i; 
rear++;          
}    
}  
} 
return 0; 
}
